{
  "name": "picklehouse-matanao",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "build:preview": "tsc -b && vite build --mode preview --outDir dist-preview",
    "test": "vitest run",
    "test:db": "scripts/local-db/run-tests.sh",
