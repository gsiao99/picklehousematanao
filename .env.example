# Copy to .env.local and fill in. Only VITE_ variables reach the browser.
# NEVER put a secret key (sb_secret_…) or the service_role key here —
# the app refuses to start if you do. See docs/backend-setup.md.

# Public site address, used for links in sign-up and password-reset emails
VITE_SITE_URL=http://localhost:5173

# Supabase → Project Settings → API Keys
VITE_SUPABASE_URL=
# The publishable key (sb_publishable_…) or the legacy anon key
VITE_SUPABASE_PUBLISHABLE_KEY=
